# Caddyfile — ingress PomagierKB (auth.* i kag.*). Format: caddy fmt --overwrite Caddyfile
{
	email {$ACME_EMAIL}
	# Na czas testów DNS/konfiguracji odkomentować staging CA (limity Let's Encrypt!):
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Log dostępu z redakcją sekretów w query stringu. Argument = sufiks pliku.
# Caddy redaguje nagłówki Cookie/Authorization sam, ale query string logował w całości —
# a /auth/callback niesie jednorazowy kod autoryzacyjny OIDC i state. Filtr `query`
# podmienia oba na REDACTED, zanim wpis trafi do pliku (a więc i do backupu).
(access_log) {
	log {
		output file /data/access-{args[0]}.log {
			roll_size 20mb
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					replace code REDACTED
					replace state REDACTED
					replace session_state REDACTED
					replace id_token_hint REDACTED
				}
			}
		}
	}
}

# Wspólne nagłówki bezpieczeństwa; CSP jako argument importu (per vhost —
# panel SPA dostaje pełną politykę, Authentik/status tylko frame-ancestors).
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "{args[0]}"
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# SSO — Authentik
auth.ilovelighting.sanok.pl {
	import security_headers "frame-ancestors 'self'"
	import access_log auth
	# Authentik nie przyjmuje uploadów — bez limitu Caddy strumieniował dowolnie duże
	# ciało do upstreamu (65 MB dochodziło do 35 MB, zanim Authentik zerwał połączenie).
	request_body {
		max_size 4MB
	}
	reverse_proxy edge-authentik-server:9000
}

# Panel + MCP — PomagierKB
kag.ilovelighting.sanok.pl {
	# Pełny CSP dla SPA panelu: skrypty wyłącznie własne (Vite bez inline), style
	# 'unsafe-inline' konieczne dla atrybutów style React/Radix, data: dla obrazków.
	import security_headers "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
	encode zstd gzip
	import access_log kag

	# 1) MCP — Streamable HTTP; auth per-user tokenem WEWNĄTRZ serwera MCP.
	#    ŚWIADOMIE BEZ forward_auth (klienci MCP nie przejdą redirectu OIDC).
	#    Tylko /mcp/<profil> (goły /mcp to strona panelu SPA — trafia do handle poniżej).
	handle /mcp/* {
		reverse_proxy kag-mcp:3001 {
			flush_interval -1
		}
	}

	# 2) Endpointy embedded outpostu Authentika (wymagane, by forward_auth działał na tym vhoście)
	handle /outpost.goauthentik.io/* {
		reverse_proxy edge-authentik-server:9000 {
			header_up Host {host}
		}
	}

	# 3) (OPCJA, domyślnie wyłączone) produktowe UI OpenSPG za forward-auth (tylko kag-admin).
	#    Wymaga dopięcia caddy do sieci kag-internal — świadoma decyzja administratora.
	# handle /openspg/* {
	# 	forward_auth edge-authentik-server:9000 {
	# 		uri /outpost.goauthentik.io/auth/caddy
	# 		copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email
	# 	}
	# 	uri strip_prefix /openspg
	# 	reverse_proxy release-openspg-server:8887
	# }

	# 4) Panel (SPA + /api) — OIDC obsługuje panel-api samodzielnie; bez forward_auth.
	handle {
		request_body {
			max_size 64MB # upload plików do ingestu
		}
		reverse_proxy kag-panel:8080 # SSE (log akcji) Caddy flushuje automatycznie
	}
}

# ── Uptime Kuma (opcjonalny monitoring; profil "monitoring" w compose) ────────
# Wymaga: rekord DNS A dla status.ilovelighting.sanok.pl oraz aplikacji forward-auth
# "Status Monitor" w Authentiku (docs/authentik-setup.md) — dostęp tylko kag-admin.
status.ilovelighting.sanok.pl {
	import security_headers "frame-ancestors 'self'"
	import access_log status
	request_body {
		max_size 4MB
	}
	handle /outpost.goauthentik.io/* {
		reverse_proxy edge-authentik-server:9000 {
			header_up Host {host}
		}
	}
	handle {
		forward_auth edge-authentik-server:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-Authentik-Username X-Authentik-Groups
		}
		reverse_proxy edge-uptime-kuma:3001
	}
}
