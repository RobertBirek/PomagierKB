# deploy/edge/.env.example — skopiuj do .env (chmod 600, właściciel root) i uzupełnij sekrety.
# Wszystkie sekrety w compose przechodzą przez ${VAR:?required} — brak = twardy fail przy starcie.

TZ=Europe/Warsaw
DATA_ROOT=/srv/kag-data

# E-mail do rejestracji ACME (Let's Encrypt)
ACME_EMAIL=jarekapka@gmail.com

# --- Obrazy ---------------------------------------------------------------
# Po pullu przypiąć digest: docker inspect --format '{{index .RepoDigests 0}}' <obraz>
#
# <NAZWA>_IMAGE_CHECK_TAG = tag LINII WYDAŃ, z której pochodzi pin. deploy/scripts/update_check.sh
# porównuje przypięty digest właśnie z tym tagiem. BEZ tej zmiennej skrypt nie zakłada już
# "latest" (dawało to fałszywe "NOWY" i sugerowało skok majora: postgres 16->18, redis 7->8,
# a dla Authentika DOWNGRADE 2025.8 -> 2025.2) — raportuje "BRAK TAGU".
CADDY_IMAGE=caddy@sha256:df7f1c2fb114453b951de51a98efc010db1655a92c2e86be6706714e2417a78d   # 2.11.4, pin 2026-09-07
CADDY_IMAGE_CHECK_TAG=2.11
# server + worker = TEN SAM obraz; brać najnowszy patch linii 2025.x
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server@sha256:f162a2664fc54337be65f796130443e19d038caa82be572b7d44aa8b1a895af2   # 2025.8, pin 2026-09-02
AUTHENTIK_IMAGE_CHECK_TAG=2025.8
POSTGRES_IMAGE=postgres@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685   # 16-alpine, pin 2026-09-02
POSTGRES_IMAGE_CHECK_TAG=16-alpine
REDIS_IMAGE=redis@sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf   # 7-alpine, pin 2026-09-02
REDIS_IMAGE_CHECK_TAG=7-alpine

# --- Sekrety Authentika ----------------------------------------------------
AUTHENTIK_SECRET_KEY=change-me                      # wygeneruj: openssl rand -base64 48
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_PASSWORD=change-me                     # wygeneruj: openssl rand -base64 36

# --- SMTP (opcjonalnie: reset haseł, zaproszenia) --------------------------
# Odkomentować tutaj ORAZ blok w compose.yaml (x-authentik-env).
# AUTHENTIK_EMAIL__HOST=
# AUTHENTIK_EMAIL__PORT=587
# AUTHENTIK_EMAIL__USERNAME=
# AUTHENTIK_EMAIL__PASSWORD=
# AUTHENTIK_EMAIL__USE_TLS=true
# AUTHENTIK_EMAIL__FROM=

# ── Monitoring (opcjonalny profil "monitoring") ──────────────────────────────
# docker compose --profile monitoring up -d; vhost status.ilovelighting.sanok.pl
KUMA_IMAGE=louislam/uptime-kuma@sha256:3d632903e6af34139a37f18055c4f1bfd9b7205ae1138f1e5e8940ddc1d176f9   # 1.x, pin 2026-09-03
KUMA_IMAGE_CHECK_TAG=1
