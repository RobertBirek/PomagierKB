# kag-egress-guard.service — reguły zapory blokujące pivot z sieci kag-egress do hosta.
# Instalacja: cp deploy/systemd/kag-egress-guard.service /etc/systemd/system/
#             systemctl daemon-reload && systemctl enable --now kag-egress-guard.service
#
# Reguły iptables nie przeżywają restartu hosta ani `docker compose down/up` sieci — dlatego
# jednostka jest oneshot z RemainAfterExit i uruchamia się PO dockerze przy każdym boocie.
# Po odtworzeniu sieci kag-egress (nowa podsieć) wystarczy `systemctl restart kag-egress-guard`;
# skrypt czyta CIDR z dockera, więc nie ma zaszytych adresów.
[Unit]
Description=PomagierKB — blokada pivotu kag-egress → usługi hosta (D6-12)
Documentation=file:/kag/docs/design/audit-2026-09.md
# After=wg-quick@wg0: guard wylicza adresy hosta z `ip addr` przy KAŻDYM starcie i zakłada
# reguły raz. Gdy tunel wstawał później, adres wg0 nie trafiał do wyliczenia i pivot
# kag-egress → host:80/443/8080 był tą drogą otwarty (potwierdzone 2026-09-08: OpenSPG
# dostawał 308 od Caddy'ego pod adresem tunelu). Ordering jest tu kontrolą, nie kosmetyką.
After=docker.service wg-quick@wg0.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=true
User=root
Group=root
WorkingDirectory=/kag
ExecStart=/kag/deploy/scripts/egress_guard.sh
ExecStop=/kag/deploy/scripts/egress_guard.sh --remove
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target
