# kag-backup.service — nocny backup stacków edge+kag (PomagierKB).
# Instalacja: cp deploy/systemd/kag-backup.{service,timer} /etc/systemd/system/
#             systemctl daemon-reload && systemctl enable --now kag-backup.timer
# Jeśli repo leży gdzie indziej niż /kag — popraw WorkingDirectory i ExecStart.
[Unit]
Description=PomagierKB — nocny backup stackow edge+kag
Documentation=file:/kag/docs/design/infra.md
After=docker.service network-online.target
Wants=docker.service network-online.target
OnFailure=kag-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/kag
Environment=DATA_ROOT=/srv/kag-data
# Cel off-site: "rclone://remote:sciezka" albo cel rsync (user@host:/sciezka).
# Puste = backup tylko lokalny + warning w manifescie.
Environment=BACKUP_OFFSITE_TARGET=
# /etc/kag/alerts.env moze definiowac BACKUP_PING_URL (ping sukcesu) i ALERT_WEBHOOK_URL.
EnvironmentFile=-/etc/kag/alerts.env
ExecStart=/kag/deploy/scripts/backup.sh
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
UMask=0077

# Hardening (skrypt potrzebuje: docker CLI + socket, odczyt /kag, zapis DATA_ROOT)
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
ReadWritePaths=/srv/kag-data
