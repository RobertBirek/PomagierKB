# kag-subiektkb-refresh.timer — 3. dzień miesiąca, 01:30 (po nocnym backupie, poza godzinami pracy;
# crawl + build trwają 3-5 h).
[Unit]
Description=PomagierKB — timer odswiezenia SubiektKB (3. dzien, 01:30)

[Timer]
OnCalendar=*-*-03 01:30:00
RandomizedDelaySec=20m
Persistent=true
Unit=kag-subiektkb-refresh.service

[Install]
WantedBy=timers.target
