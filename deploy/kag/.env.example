# =============================================================================
# deploy/kag/.env.example — szablon konfiguracji stacka "kag" (PomagierKB)
#
# Użycie:  cp .env.example .env && chmod 600 .env   (właściciel: root)
# .env NIGDY nie trafia do gita (.gitignore). Compose wymusza sekrety przez
# ${X:?...} — brak wartości = stack nie wstaje.
#
# Profil RAM: 24 GB (PLAN.md, tabela "Profil RAM (24 GB)") — NADPISUJE profil
# S/32G z docs/design/infra.md; skalowanie = edycja tego pliku, nie compose.
#
# Klucze LLM (chat_llm/openie_llm) NIE żyją tutaj — trzymane w ustawieniach
# panelu (SQLite, sealed AES-GCM), wstrzykiwane do OpenSPG per projekt.
# =============================================================================

TZ=Europe/Warsaw
# korzeń danych bind-mountów (katalogi tworzy deploy/scripts/bootstrap.sh)
DATA_ROOT=/srv/kag-data

# --- Obrazy (digesty zweryfikowane — docs/design/infra.md §3) -----------------
# <NAZWA>_IMAGE_CHECK_TAG = tag LINII WYDAŃ, z której pochodzi pin; deploy/scripts/update_check.sh
# porównuje przypięty digest właśnie z nim. Brak zmiennej = status "BRAK TAGU" (skrypt NIE
# zakłada już "latest" — to dawało fałszywe "NOWY" i sugerowało skok na inną linię wydań).
# Obrazy spg-registry.* (OpenSPG) są FROZEN — sprawdzane informacyjnie względem "latest",
# bez zalecenia aktualizacji; CHECK_TAG nie jest dla nich potrzebny.
OPENSPG_MYSQL_IMAGE=spg-registry.us-west-1.cr.aliyuncs.com/spg/openspg-mysql@sha256:71eb546d5fc5faf70b3d8a358c022f601591b54a029b79298f2fa0302e46de9a    # build 2025-06-30 (MariaDB 10.5.8)
OPENSPG_NEO4J_IMAGE=spg-registry.us-west-1.cr.aliyuncs.com/spg/openspg-neo4j@sha256:4bc5b7f6b83d333b1d2c8f60ac145c068d77d50bca65b3a07c927f9e2a541eb9    # build 2024-11-20 (DozerDB 5.25.1.0-alpha.1)
OPENSPG_MINIO_IMAGE=spg-registry.us-west-1.cr.aliyuncs.com/spg/openspg-minio@sha256:9493c8e8f77edb10d556255d49ba8b5761b0fe57889235dfd10619c0513da007   # build 2024-12-19
OPENSPG_SERVER_IMAGE=spg-registry.us-west-1.cr.aliyuncs.com/spg/openspg-server@sha256:fe6708deef9ebb8da8da7b1cb643e83b827769a5be8811961311639aa1f2cb88 # build 2025-07-03 (==0.8/latest)
# Obraz BAZOWY Tiki (minimalny, bez -full). Nasz obraz kag-tika:local buduje się z niego
# (services/tika/Dockerfile: + Tesseract pol/eng + tika-config.json). Po zmianie digestu:
#   docker compose -f deploy/kag/compose.yaml build tika && docker compose ... up -d tika
TIKA_IMAGE=apache/tika@sha256:06bcdbd09aca073293e5a171ad161418cc93c91d58d9e4e205064eade84889d4   # 4.1.0 (tag 4.1.0-1), pin 2026-10-05
# apache/tika NIE publikuje tagu linii (są tylko dokładne wersje + `latest`) — jako CHECK_TAG
# podajemy dokładny tag pinu: update_check pilnuje, że tag nie został podmieniony pod tym
# samym numerem. Zmiana linii (4.1 → 4.2) = plan jak docs/superpowers/plans/2026-10-05-tika-4-polish-ocr.md.
TIKA_IMAGE_CHECK_TAG=4.1.0-1
# Pin po digeście (parsuje NIEZAUFANE uploady — bez driftu supply-chain); aktualizacja
# tylko świadoma: nowy digest z `docker buildx imagetools inspect` + test smoke.
STIRLING_IMAGE=docker.io/stirlingtools/stirling-pdf@sha256:c195925341aa35ee5932d9c225edef48a92e46a1280963180d79619cb5f29e6e   # 3.0.2, pin 2026-10-05
# Dokładny tag pinu, NIE "latest": "latest" przeskakuje wersje główne (2.14.3 -> 3.0.2 wyglądało jak
# zwykłe podbicie). Zmiana wersji = próba obu wersji obok siebie na kodzie ekstrakcji panelu
# (docs/ops/cve-baseline-log.md, wpis 2026-10-05).
STIRLING_IMAGE_CHECK_TAG=3.0.2

# --- MySQL (obraz "openspg-mysql" = MariaDB) ---------------------------------
MYSQL_DATABASE=openspg
# openssl rand -base64 24
MYSQL_ROOT_PASSWORD=change-me
# użytkownik aplikacyjny — tworzy go mysql-init/10-create-app-user.sh przy
# PIERWSZEJ inicjalizacji wolumenu; serwer OpenSPG loguje się nim, nie rootem
MYSQL_APP_USER=openspg_app
# openssl rand -base64 24
MYSQL_APP_PASSWORD=change-me

# --- Neo4j (DozerDB) ---------------------------------------------------------
OPENSPG_NEO4J_USER=neo4j
# openssl rand -base64 24
OPENSPG_NEO4J_PASSWORD=change-me
# wariant do URL-i CLOUDEXT_* (OpenSPG wymaga sekretów inline w URL). Helper:
# python3 -c 'import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1],safe=""))' 'HASŁO'
OPENSPG_NEO4J_PASSWORD_URLENCODED=change-me-urlencoded

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=kagminio
# openssl rand -base64 24
MINIO_ROOT_PASSWORD=change-me
# jw. — wariant urlencoded do CLOUDEXT_OBJECTSTORAGE_URL
MINIO_ROOT_PASSWORD_URLENCODED=change-me-urlencoded

# --- Profil RAM 24 GB: limity pamięci i heapy (PLAN.md) ----------------------
# suma limitów stacka kag ~18g + edge ~3g ≈ 21g; bootstrap tworzy swap 8G
MYSQL_MEM_LIMIT=2g
NEO4J_MEM_LIMIT=4g
NEO4J_HEAP=2G
NEO4J_PAGECACHE=1G
MINIO_MEM_LIMIT=768m
OPENSPG_SERVER_MEM_LIMIT=4608m
OPENSPG_SERVER_XMS=1024m
OPENSPG_SERVER_XMX=3072m
TIKA_MEM_LIMIT=1536m
STIRLING_MEM_LIMIT=2g
STIRLING_JAVA_OPTS=-Xmx1g
PANEL_MEM_LIMIT=1536m
# sterta V8 procesów potomnych jobs/ (build 14 600 chunków potrzebował >256 MB) — musi mieścić się w PANEL_MEM_LIMIT
JOB_NODE_MAX_OLD_SPACE_MB=1024
MCP_MEM_LIMIT=384m
# równoległość buildera OpenSPG (profil 24G: 4; profil M/64G: 6)
BUILDER_MODEL_EXECUTE_NUM=4

# --- Panel (OIDC przez Authentik — docs/authentik-setup.md) ------------------
PANEL_PUBLIC_URL=https://kag.ilovelighting.sanok.pl
PANEL_OIDC_ISSUER=https://auth.ilovelighting.sanok.pl/application/o/kag-panel/
PANEL_OIDC_CLIENT_ID=kag-panel
# z Authentika: provider kag-panel-oidc (Confidential) → Client Secret
PANEL_OIDC_CLIENT_SECRET=change-me
# sekret podpisu sesji: openssl rand -base64 48
PANEL_SESSION_SECRET=change-me
# klucz AES-256-GCM do seal sekretów w SQLite (dokładnie 64 znaki hex):
# openssl rand -hex 32
TOKEN_ENC_KEY=change-me
# token wewnętrzny panel↔mcp: openssl rand -base64 32
PANEL_INTERNAL_TOKEN=change-me

# --- OpenSPG API (konto serwisowe używane przez panel i mcp) -----------------
# login produktowy do endpointów /v1/* i /public/v1/* (patrz .claude/skills/openspg-api)
OPENSPG_ACCOUNT=openspg
# openssl rand -base64 24
OPENSPG_PASSWORD=change-me

# --- MCP ---------------------------------------------------------------------
MCP_PUBLIC_URL=https://kag.ilovelighting.sanok.pl/mcp
