{
  "name": "@pomagierkb/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db": "./dist/db/index.js",
    "./audit": "./dist/audit/index.js",
    "./crypto": "./dist/crypto/index.js",
    "./openspg": "./dist/openspg/index.js",
    "./llm": "./dist/llm/index.js",
    "./errors": "./dist/errors.js",
    "./schemas": "./dist/schemas/index.js",
    "./answer": "./dist/answer/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
